# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── CopilotKit ────────────────────────────────────────────────────────────────
COPILOTKIT_API_KEY=ck_pub_...

# ── Ports ─────────────────────────────────────────────────────────────────────
AGENT_PORT=2024
MCP_PORT=3001
FRONTEND_PORT=3000

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_AGENT_URL=http://localhost:2024
NEXT_PUBLIC_MCP_URL=http://localhost:3001
NEXT_PUBLIC_COPILOTKIT_PUBLIC_API_KEY=ck_pub_...

# ── Feature flags ─────────────────────────────────────────────────────────────
# DEMO_MODE=true — usa perfiles hardcodeados, no requiere ANTHROPIC_API_KEY
DEMO_MODE=false
# DEBUG=true — habilita logging verbose en frontend y backend
DEBUG=false
